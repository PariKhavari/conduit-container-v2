POSTGRES_DB=conduit
POSTGRES_USER=conduit_user
# Avoid special characters like $, &, * (can break Docker Compose variable interpolation)
POSTGRES_PASSWORD=change_me

DJANGO_SECRET_KEY=change_me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Required: overrides the interactively-typed password when running createsuperuser (see README)
DJANGO_SUPERUSER_PASSWORD=superuser_password

CORS_ORIGIN_ALLOW_ALL=false
CORS_ORIGIN_WHITELIST=http://localhost:8282